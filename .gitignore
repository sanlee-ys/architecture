# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini

# Portal (architecture/ADR-001) — both are generated; never commit them.
# `portal/` is assembled by scripts/build_portal.py; `site/` is the MkDocs build output.
portal/
site/

graphify-out/

# Bytecode from scripts/ and tests/ (run locally).
__pycache__/
*.pyc

# pytest's run cache. Never committed; also excluded from the CI run itself
# (`-p no:cacheprovider` in checks.yml) so the decision-log lint's whole-repo sweep in
# the following step does not walk a tool cache it does not own.
.pytest_cache/
